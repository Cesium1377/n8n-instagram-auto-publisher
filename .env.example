# Example environment variables for the n8n instance that runs this workflow.
#
# These are n8n's own PROCESS environment variables — set them wherever you
# start n8n (your shell, a .env file loaded by your process manager, a Docker
# Compose file, etc.). n8n workflows do NOT read .env files themselves; the
# workflow's own configuration (root folder, account ID, model, etc.) lives
# inside the "Config" node in the imported workflow — see README.md.
#
# Copy this file to `.env` (or merge these into your existing n8n env setup)
# and fill in real values. Never commit a real `.env` file — it's gitignored.

# --- Required for the Code nodes in this workflow ---
# The "Prepare Folders & Pick File" and "Move File to PUBLISHED" nodes use
# Node's built-in fs/path modules directly, which n8n blocks by default.
NODE_FUNCTION_ALLOW_BUILTIN=fs,path

# --- Recommended if you self-host n8n ---
# Restricts which folders n8n's file nodes are allowed to read/write.
# Set this to your chosen root folder (see Config.ROOT_DIR in the workflow).
N8N_RESTRICT_FILE_ACCESS_TO=C:\Instagram-Automation

# --- Standard n8n instance settings (adjust to your own setup) ---
N8N_PORT=5678
N8N_USER_FOLDER=./n8n-data
GENERIC_TIMEZONE=UTC

# --- Only relevant if you're copying an existing n8n data folder between
#     machines and want stored credentials to keep decrypting correctly.
#     Generate your own value; never reuse an example or a shared one. ---
# N8N_ENCRYPTION_KEY=

# --- This workflow's own required values (for reference only — set these
#     inside the imported workflow's "Config" node, NOT here) ---
# IG_ACCOUNT_ID=YOUR_INSTAGRAM_ACCOUNT_ID
# INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN   (goes into the Header Auth credential, not the workflow)
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY                    (goes into the Gemini credential, not the workflow)
