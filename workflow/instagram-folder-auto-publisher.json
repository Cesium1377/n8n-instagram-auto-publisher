    {
      "name": "Move File to PUBLISHED",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2780,
        160
      ],
      "parameters": {
        "jsCode": "// Runs only after \"Publish to Instagram\" succeeded.\n// Instagram returns the new media id only when the post is live; without it nothing is moved.\nconst fs = require('fs');\nconst path = require('path');\n\nconst cfg = $('Config').first().json;\nconst pick = $('Prepare Folders & Pick File').first().json;\nconst mediaId = $input.first().json.id;\n\nif (!mediaId) {\n  throw new Error('Instagram did not return a media id, so the post is not confirmed. \"' + pick.fileName + '\" stays in QUEUE.');\n}\n\nconst ROOT = String(cfg.ROOT_DIR || '').trim().replace(/[\\\\/]+$/, '');\nconst PUBLISHED = path.join(ROOT, 'PUBLISHED');\nfs.mkdirSync(PUBLISHED, { recursive: true });\n\nconst p = path.parse(pick.fileName);\nlet destName = pick.fileName;\nlet i = 1;\nwhile (fs.existsSync(path.join(PUBLISHED, destName))) destName = p.name + ' (' + (++i) + ')' + p.ext;\nconst dest = path.join(PUBLISHED, destName);\n\n// Windows can hold a short lock on a file that was just read, so try a few times.\nconst sleep = (ms) => new Promise((resolve) => (typeof setTimeout === 'function' ? setTimeout(resolve, ms) : resolve()));\nlet lastError = null;\nfor (let attempt = 1; attempt <= 5; attempt++) {\n  try { fs.renameSync(pick.filePath, dest); lastError = null; break; } catch (e) { lastError = e; await sleep(2000); }\n}\nif (lastError) {\n  throw new Error('POSTED on Instagram (media id ' + mediaId + ') but could not move \"' + pick.fileName +\n    '\" to PUBLISHED: ' + lastError.message + '. Move it into PUBLISHED by hand so it is not posted again.');\n}\n\nreturn [{\n  json: {\n    status: 'published',\n    instagramMediaId: mediaId,\n    fileName: pick.fileName,\n    movedTo: dest,\n    caption: $('Clean Caption').first().json.caption,\n  },\n}];\n"
      },
      "id": "4c8845e9-a8a8-4db4-b7fe-3eb31e99727f"
    },
