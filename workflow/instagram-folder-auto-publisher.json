    {
      "name": "Prepare Folders & Pick File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        260
      ],
      "parameters": {
        "jsCode": "// 1) Creates QUEUE and PUBLISHED if they are missing.\n// 2) Moves finished copies of supported media from the root folder into QUEUE.\n// 3) Picks ONE file from QUEUE (the one that has waited longest).\n// PUBLISHED is never scanned, so a published file can never be picked again.\nconst fs = require('fs');\nconst path = require('path');\n\nconst cfg = $('Config').first().json;\nconst ROOT = String(cfg.ROOT_DIR || '').trim().replace(/[\\\\/]+$/, '');\nconst QUEUE = path.join(ROOT, 'QUEUE');\nconst PUBLISHED = path.join(ROOT, 'PUBLISHED');\n\nif (!cfg.IG_ACCOUNT_ID || String(cfg.IG_ACCOUNT_ID).startsWith('PASTE')) {\n  throw new Error('Open the \"Config\" node and set IG_ACCOUNT_ID first.');\n}\nif (!ROOT || !fs.existsSync(ROOT)) {\n  throw new Error('Root folder not found: ' + ROOT + ' (check ROOT_DIR in the Config node)');\n}\n\nfs.mkdirSync(QUEUE, { recursive: true });\nfs.mkdirSync(PUBLISHED, { recursive: true });\n\nconst extList = (s) => String(s || '').toLowerCase().split(',').map((x) => x.trim()).filter(Boolean);\nconst VIDEO_EXT = extList(cfg.VIDEO_EXTENSIONS);\nconst IMAGE_EXT = extList(cfg.IMAGE_EXTENSIONS);\nconst MIN_AGE_MS = (Number(cfg.MIN_FILE_AGE_SECONDS) || 60) * 1000;\n\nconst kindOf = (name) => {\n  const ext = path.extname(name).toLowerCase();\n  if (VIDEO_EXT.includes(ext)) return 'video';\n  if (IMAGE_EXT.includes(ext)) return 'image';\n  return null;\n};\n\n// \"clip.mp4\" -> \"clip (2).mp4\" if the name is already taken\nconst freeName = (dir, name) => {\n  const p = path.parse(name);\n  let candidate = name;\n  let i = 1;\n  while (fs.existsSync(path.join(dir, candidate))) candidate = p.name + ' (' + (++i) + ')' + p.ext;\n  return candidate;\n};\n\n// ---- 1) root folder -> QUEUE ----\nconst movedIntoQueue = [];\nconst stillCopying = [];\nconst ignoredInRoot = [];\n\nfor (const ent of fs.readdirSync(ROOT, { withFileTypes: true })) {\n  if (!ent.isFile()) continue;\n  if (!kindOf(ent.name)) {\n    if (!/^desktop\\.ini$|^thumbs\\.db$/i.test(ent.name)) ignoredInRoot.push(ent.name);\n    continue;\n  }\n  const src = path.join(ROOT, ent.name);\n  let st;\n  try { st = fs.statSync(src); } catch (e) { continue; }\n\n  // Skip files that are empty or were written in the last MIN_FILE_AGE_SECONDS (copy still running)\n  if (st.size === 0 || Date.now() - st.mtimeMs < MIN_AGE_MS) { stillCopying.push(ent.name); continue; }\n\n  // { } would be read as a pattern by the file node, so replace them\n  const destName = freeName(QUEUE, ent.name.replace(/[{}]/g, '-'));\n  const dest = path.join(QUEUE, destName);\n  try {\n    fs.renameSync(src, dest);\n    const now = new Date();\n    fs.utimesSync(dest, now, now); // queue order = order files arrived in QUEUE\n    movedIntoQueue.push(destName);\n  } catch (e) {\n    stillCopying.push(ent.name); // locked by Windows (still copying) -> next run\n  }\n}\n\n// ---- 2) pick one file from QUEUE ----\nconst queue = [];\nfor (const ent of fs.readdirSync(QUEUE, { withFileTypes: true })) {\n  if (!ent.isFile()) continue;\n  const kind = kindOf(ent.name);\n  if (!kind) continue;\n  const filePath = path.join(QUEUE, ent.name);\n  try {\n    const st = fs.statSync(filePath);\n    if (st.size > 0) queue.push({ name: ent.name, filePath, size: st.size, mtimeMs: st.mtimeMs, kind });\n  } catch (e) { /* file vanished */ }\n}\n\nif (!queue.length) {\n  // Nothing to publish: the run ends here without error.\n  return [];\n}\n\nqueue.sort((a, b) => a.mtimeMs - b.mtimeMs || a.name.localeCompare(b.name));\nconst pick = queue[0];\n\n// Put the picked file at the back of the line. If this run fails, the next run\n// tries a different file first instead of getting stuck on a bad one.\ntry { const now = new Date(); fs.utimesSync(pick.filePath, now, now); } catch (e) { /* not critical */ }\n\nreturn [{\n  json: {\n    fileName: pick.name,\n    filePath: pick.filePath,\n    fileSize: pick.size,\n    mediaKind: pick.kind,\n    queueLength: queue.length,\n    movedIntoQueue,\n    stillCopying,\n    ignoredInRoot,\n  },\n}];\n"
      },
      "id": "74d04d77-bec4-4b1c-901a-7b878d5f1eb5"
    },
